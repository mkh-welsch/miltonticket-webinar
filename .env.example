# Public deployment URL, for example https://webinar.miltonticket.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stream Video application. The API key is public; the secret is server-only.
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_SECRET_KEY=

# Dedicated HMAC secrets. Use two different random values with at least 32 characters.
# MILTON_WEBINAR_HANDOFF_SECRET is shared with miltonticket-app to sign one-time handoffs.
MILTON_WEBINAR_HANDOFF_SECRET=replace-with-a-dedicated-32-character-secret
WEBINAR_SESSION_SECRET=replace-with-a-different-32-character-secret

# Signed event delivery from this service back to the Milton API.
MILTON_API_BASE_URL=http://localhost:3001
# Comma-separated exact HTTPS origins accepted for Milton API calls.
MILTON_API_ALLOWED_ORIGINS=https://miltonticket.app
MILTON_WEBINAR_EVENTS_SECRET=replace-with-a-third-dedicated-32-character-secret
MILTON_WEBINAR_CONTROL_SECRET=replace-with-a-fourth-dedicated-32-character-secret

# Recording remains fail-closed until the DPA, notice and retention policy are approved.
WEBINAR_RECORDING_ENABLED=false
WEBINAR_RECORDING_MAX_RETENTION_DAYS=30

# Local development only. Never enable this in a production deployment.
WEBINAR_DEMO_MODE=false
